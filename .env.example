# --- DISCORD CONFIGURATION ---
# Bot Token from https://discord.com/developers/applications (enable MESSAGE CONTENT INTENT)
DISCORD_TOKEN=your_discord_bot_token_here

# Channel for the daily digest, source alerts, and commands. Required for the digest.
DISCORD_CHANNEL_ID=

# (Optional) Comma-separated Discord user IDs allowed to use commands
DISCORD_AUTHORIZED_USERS=

# --- DIGEST ---
# (Optional) Digest time, Asia/Jakarta, HH:MM. Default 20:00 — posted Sunday–Thursday evening,
# before each trading day. A time before 16:00 (market close) posts Monday–Friday instead.
# DIGEST_TIME=20:00

# (Optional) How many days ahead the digest looks. Default 7
# DIGEST_DAYS=7
